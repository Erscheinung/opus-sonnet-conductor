{
  "name": "orchestrator-budget",
  "version": "1.0.0",
  "description": "provider spend in context + status line, a live background refresher (no lag), and a daily task-budget soft-gate for the adaptive orchestrator.",
  "author": {
    "name": "opus-sonnet-orchestrator"
  },
  "commands": [
    "./commands/orchestrator-spending.md"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/alarms.js\"",
            "timeout": 12,
            "statusMessage": "Checking provider spend..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/alarms.js\"",
            "timeout": 12
          }
        ]
      }
    ]
  }
}
